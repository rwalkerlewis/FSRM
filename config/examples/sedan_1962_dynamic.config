# Sedan Crater, Nevada Test Site (1962) -- Operation Storax / Plowshare
# 104 kt device detonated at 194m depth in alluvium (shallow burial)
#
# Pass-5 variant: drives the far-field FEM problem from the recorded
# 1D NearFieldExplosionSolver moment-tensor history (full 6 components,
# including CLVD content) instead of the closed-form RDP psi_dot
# scaled trace. See docs/HISTORIC_NUCLEAR_FIDELITY.md "Closed in
# pass 5" and docs/HISTORIC_NUCLEAR_ROADMAP.md axis 1 for context.
#
# Anchor event for pass-5 because:
#   1. Cratering shot exercises near-surface damage and free-surface
#      spall (largest US nuclear crater, 390 m diameter, 100 m deep).
#   2. Alluvium medium puts the cavity radius at a tractable scale
#      (Rc ~ 87 m via the medium-aware NTS coefficient) vs the
#      far-field cell scale (Lz / nz = 500 m).
#   3. Already covered by the pass-4 _Distributed envelope (factor 30)
#      so the pass-5 dynamic-plastic comparison isolates the
#      kinematic-vs-dynamic moment-tensor change.
#
# Coordinate system: z=0 at bottom (5000m depth), z=5000 at surface
# Explosion at 194m depth = z=4806 (within alluvium, very shallow)
#
# Layer structure (NTS Yucca Flat area):
#   Alluvium:              0-300m depth   (z=4700 to z=5000)
#   Welded tuff:           300-800m depth (z=4200 to z=4700)
#   Paleozoic carbonate:   800-5000m depth (z=0 to z=4200)

[SIMULATION]
name = sedan_1962_dynamic
start_time = 0.0
end_time = 5.0
dt_initial = 0.001
dt_min = 0.0001
dt_max = 0.01
max_timesteps = 5000
output_frequency = 500
output_format = HDF5
fluid_model = NONE
solid_model = ELASTIC
enable_geomechanics = true
enable_faults = false
enable_elastodynamics = true
rtol = 1.0e-6
atol = 1.0e-8
max_nonlinear_iterations = 20

[GRID]
nx = 15
ny = 15
nz = 10
Lx = 30000.0
Ly = 30000.0
Lz = 5000.0

[ROCK]
density = 2700.0
youngs_modulus = 65.0e9
poissons_ratio = 0.25

[MATERIAL]
heterogeneous = true
gravity = 0.0

[LAYER_1]
z_top = 5000.0
z_bottom = 4700.0
lambda = 3.33e9
mu = 1.09e9
rho = 1700.0

[LAYER_2]
z_top = 4700.0
z_bottom = 4200.0
lambda = 1.42e10
mu = 1.33e10
rho = 2300.0

[LAYER_3]
z_top = 4200.0
z_bottom = 0.0
lambda = 3.37e10
mu = 2.59e10
rho = 2700.0

[EXPLOSION_SOURCE]
type = UNDERGROUND_NUCLEAR
yield_kt = 104.0
depth_of_burial = 194.0
location_x = 15000.0
location_y = 15000.0
location_z = 4806.0
onset_time = 0.0
rise_time = 0.02
cavity_overpressure = 1.0e10
medium_type = ALLUVIUM

# Pass-4: distribute the moment over a multi-cell support ball so the
# refinement-friendly delta-function limit is approached on the 15x15x10
# production mesh. Same factor used by the _Distributed integration
# variants.
[SOURCE_DISTRIBUTION]
mode = UNIFORM_SPHERE
support_radius_factor = 50.0
min_cells = 1

# Pass-5: dynamic-plastic near-field source. The 1D
# NearFieldExplosionSolver runs at setup time, samples the full
# 6-component moment-rate tensor at the configured cadence over a
# spherical extraction surface at elastic_radius_factor * Rc, and
# writes the recorded history to <output_dir>/near_field_history.csv.
# addExplosionSourceToResidual interpolates from this history and
# injects the FULL Mdot_ij tensor (with CLVD content) into the
# far-field linear-elastic problem.
[NEAR_FIELD_SOURCE]
mode = DYNAMIC_PLASTIC
elastic_radius_factor = 3.0
near_field_dt = 1.0e-5
damage_model = DRUCKER_PRAGER
output_cadence_microseconds = 100

[BOUNDARY_CONDITIONS]
bottom = free
sides = free
top = free

[ABSORBING_BC]
enabled = true
x_min = true
x_max = true
y_min = true
y_max = true
z_min = true
z_max = false

[SEISMOMETERS]
enabled = true
formats = SAC
output_dir = output/sedan_1962_dynamic
default_quantity = DISPLACEMENT
default_sample_rate_hz = 100.0

[SEISMOMETER_1]
sta = SPALL
location_xyz = 15000.0,15000.0,5000.0

[SEISMOMETER_2]
sta = STA05
location_xyz = 20000.0,15000.0,5000.0

[SEISMOMETER_3]
sta = STA10
location_xyz = 25000.0,15000.0,5000.0
