# Salmon (Project Dribble), Tatum Salt Dome, MS (1964-10-22)
# 5.3 kt device detonated at 828 m depth in halite of the Tatum Salt Dome
# Site: Lamar County, Mississippi (~31.14 N, -89.57 E)
#
# PASS-9 HIGH-TIER VARIANT. Updated from pass-8 to opt into the new
# tabulated EOS / opacity patches and the second-order Strang
# operator split. The MED-tier pass-8 byte-identical Salmon Marshak
# config is kept under the pass-8 PR's salmon_1964_marshak_pass8.config
# (or recoverable from git) for regression. The pass-9 HIGH tier
# enables:
#   cavity_eos = TILLOTSON_TABULATED_PATCH
#   opacity_model = TABULATED_PATCHED
#   operator_splitting = STRANG
# These are the documented-default-when-coupled settings for
# high-fidelity historic-nuclear runs in pass-9. Users opting back
# into MED tier set cavity_eos = TILLOTSON, opacity_model =
# POWER_LAW_ZR, operator_splitting = LIE.
#
# Identical to salmon_1964.config except for the [NEAR_FIELD_SOURCE]
# block (radiation phase + EOS / opacity / split tier). The far-field
# elastic pipeline is unchanged.
#
# References for the V&V gates anchored on this run:
#   Springer et al. 1968 (cavity radius 17.4 m post-shot drillback)
#   Healy 1971 USGS Project Dribble (free-field velocity gauges)
#   Patton 1991 BSSA (long-period source spectrum, mb 4.9)
#   Stump et al. 1994 (regional discriminant analysis)
#
# Coordinate system: z=0 at bottom (2000m depth), z=2000 at surface
# Explosion at 828 m depth = z=1172 (within Louann/Tatum salt)
#
# Layer structure (Springer et al. 1968; Patton 1991; Stump et al. 1994):
#   Surface alluvium / cap soils: 0-200m   (z=1800 to z=2000)
#   Tertiary sand-shale sequence: 200-500m (z=1500 to z=1800)
#   Cap rock (anhydrite/gypsum):  500-700m (z=1300 to z=1500)
#   Tatum dome halite:            700-2000m (z=0 to z=1300; emplacement)

[SIMULATION]
name = salmon_1964_marshak
start_time = 0.0
end_time = 5.0
dt_initial = 0.001
dt_min = 0.0001
dt_max = 0.01
max_timesteps = 5000
output_frequency = 500
output_format = HDF5
fluid_model = NONE
solid_model = ELASTIC
enable_geomechanics = true
enable_faults = false
enable_elastodynamics = true
rtol = 1.0e-6
atol = 1.0e-8
max_nonlinear_iterations = 20

[GRID]
nx = 15
ny = 15
nz = 10
Lx = 4000.0
Ly = 4000.0
Lz = 2000.0

[ROCK]
density = 2200.0
youngs_modulus = 35.0e9
poissons_ratio = 0.28

[MATERIAL]
heterogeneous = true
gravity = 0.0

[LAYER_1]
z_top = 2000.0
z_bottom = 1800.0
lambda = 2.54e9
mu = 1.62e9
rho = 2000.0

[LAYER_2]
z_top = 1800.0
z_bottom = 1500.0
lambda = 6.70e9
mu = 5.40e9
rho = 2400.0

[LAYER_3]
z_top = 1500.0
z_bottom = 1300.0
lambda = 1.06e10
mu = 1.00e10
rho = 2500.0

[LAYER_4]
z_top = 1300.0
z_bottom = 0.0
lambda = 1.71e10
mu = 1.38e10
rho = 2200.0

[EXPLOSION_SOURCE]
type = UNDERGROUND_NUCLEAR
yield_kt = 5.3
depth_of_burial = 828.0
location_x = 2000.0
location_y = 2000.0
location_z = 1172.0
onset_time = 0.0
rise_time = 0.09
cavity_overpressure = 1.0e10
medium_type = SALT

# Pass-8 dynamic-plastic near-field source with Marshak grey
# radiation-diffusion phase. Defaults that are NOT explicit here
# fall back to the pass-7 RADIAL_LAGRANGIAN production settings.
[NEAR_FIELD_SOURCE]
mode = DYNAMIC_PLASTIC
solver_kind = RADIAL_LAGRANGIAN
elastic_radius_factor = 3.0
near_field_dt = 1.0e-5
output_cadence_microseconds = 100
profile_output_cadence_microseconds = 100
radial_cells = 200
# Pass-9 HIGH tier: tabulated EOS + tabulated opacity + Strang split.
cavity_eos = TILLOTSON_TABULATED_PATCH
tillotson_parameter_set = SALT
cavity_initialization = PHYSICS_BASED
# The MARSHAK_GREY radiation phase is unchanged from pass-8 MED tier;
# pass-9 advances the EOS and opacity ladders one rung each. The
# tabulated_*_path keys are auto-derived from the medium label
# (resolves to tools/tabulated_data/tables/eos/salt_aneos.h5 etc.);
# users with custom tables override explicitly.
radiation_phase = MARSHAK_GREY
opacity_model = TABULATED_PATCHED
operator_splitting = STRANG
tabulated_eos_blend_lower_pa = 5.0e10
tabulated_eos_blend_upper_pa = 6.0e10
tabulated_opacity_blend_lower_k = 1.0e5
tabulated_opacity_blend_upper_k = 1.26e5
radiation_max_newton_iter = 10
radiation_newton_tolerance = 1.0e-6
radiation_handoff_debounce_steps = 3
tillotson_extrapolation_warning_threshold_pa = 5e10

[BOUNDARY_CONDITIONS]
bottom = free
sides = free
top = free

[ABSORBING_BC]
enabled = true
x_min = true
x_max = true
y_min = true
y_max = true
z_min = true
z_max = false

[SEISMOMETERS]
enabled = true
formats = SAC
output_dir = output/salmon_1964_marshak
default_quantity = DISPLACEMENT
default_sample_rate_hz = 100.0

[SEISMOMETER_1]
sta = SPALL
location_xyz = 2000.0,2000.0,2000.0

[SEISMOMETER_2]
sta = STA01
location_xyz = 2800.0,2000.0,2000.0

[SEISMOMETER_3]
sta = STA02
location_xyz = 3600.0,2000.0,2000.0

# Pass-8 waveform V&V config block. The C++ iris_validation tests
# read this section to know which event manifest entry to anchor on
# and which metric configuration to apply.
[WAVEFORM_VV]
enabled = true
cache_root = tools/waveform_vv/cache
events = Salmon1964
metric_freq_band_hz_min = 0.5
metric_freq_band_hz_max = 5.0
metric_lag_window_s = 5.0
