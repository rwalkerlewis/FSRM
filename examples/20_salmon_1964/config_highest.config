# Salmon (Project Dribble), Tatum Salt Dome, MS (1964-10-22)
# 5.3 kt device detonated at 828 m depth in halite of the Tatum Salt Dome
# Site: Lamar County, Mississippi (~31.14 N, -89.57 E)
#
# PASS-10 HIGHEST-TIER VARIANT (axis-1a closeout). All five axis-1a
# fidelity ladders engaged at their HIGHEST rung:
#   radiation_phase = MARSHAK_MULTIGROUP   (per-group analytic opacity)
#   cavity_eos      = TABULATED_FULL        (pure tabulated, no patch)
#   opacity_model   = TABULATED_FULL        (pure tabulated grey lookup
#                                            -- when MULTIGROUP is engaged
#                                            this signals the per-group
#                                            analytic path A; the 2D table
#                                            stays on disk as offline
#                                            reference only)
#   operator_splitting = STRANG_MULTIGROUP  (second-order Strang split
#                                            applied to the multigroup
#                                            block; alias for STRANG when
#                                            radiation_phase = MARSHAK_MULTIGROUP)
#   time_integrator = RK3_SSP               (Shu-Osher 1988 SSP3;
#                                            unblocks the 549 m
#                                            free-field gauge)
#
# This config exercises every axis-1a HIGHEST-tier feature shipped in
# pass-10. The companion salmon_1964_marshak.config is the pass-9 HIGH
# tier (TILLOTSON_TABULATED_PATCH + TABULATED_PATCHED + STRANG +
# EXPLICIT_EULER + MARSHAK_GREY); recovering pass-9 byte-identical
# output requires that config.
#
# Pass-10 references for this example:
#   Mihalas-Mihalas 1984 sec 80, 82.2 (multigroup diffusion, line opacity).
#   Pomraning 1973 ch IV (multigroup formulation).
#   Shu-Osher 1988 (SSP3 RK scheme).
#   Strang 1968 (operator splitting).
#   Springer et al. 1968 (Salmon cavity radius 17.4 m post-shot).
#   Healy 1971 USGS Project Dribble (free-field velocity gauges).
#   Patton 1991 BSSA (long-period source spectrum, mb 4.9).
#
# Coordinate system identical to salmon_1964_marshak.config: z=0 at
# bottom (2000m depth), z=2000 at surface; explosion at 828 m depth = z=1172.

[SIMULATION]
name = salmon_1964_highest
start_time = 0.0
end_time = 5.0
dt_initial = 0.001
dt_min = 0.0001
dt_max = 0.01
max_timesteps = 5000
output_frequency = 500
output_format = HDF5
fluid_model = NONE
solid_model = ELASTIC
enable_geomechanics = true
enable_faults = false
enable_elastodynamics = true
rtol = 1.0e-6
atol = 1.0e-8
max_nonlinear_iterations = 20

[GRID]
nx = 15
ny = 15
nz = 10
xmin = -2000.0
xmax = 2000.0
ymin = -2000.0
ymax = 2000.0
zmin = 0.0
zmax = 2000.0

[MATERIAL]
default_density = 2160.0
default_poisson_ratio = 0.30
default_youngs_modulus = 3.4e10

[LAYER_1]
name = surface_alluvium
z_min = 1800.0
z_max = 2000.0
density = 1900.0
vp = 1800.0
vs = 800.0

[LAYER_2]
name = tertiary_sediment
z_min = 1500.0
z_max = 1800.0
density = 2100.0
vp = 2700.0
vs = 1300.0

[LAYER_3]
name = caprock_anhydrite
z_min = 1300.0
z_max = 1500.0
density = 2400.0
vp = 4400.0
vs = 2500.0

[LAYER_4]
name = tatum_dome_halite
z_min = 0.0
z_max = 1300.0
density = 2160.0
vp = 4500.0
vs = 2500.0

[EXPLOSION_SOURCE]
yield_kt = 5.3
location_x = 0.0
location_y = 0.0
location_z = 1172.0
detonation_time = 0.05
rise_time = 0.09
cavity_overpressure = 1.0e10
medium_type = SALT

# Pass-10 HIGHEST tier: multigroup transport + tabulated EOS / opacity
# everywhere + RK3_SSP explicit time integrator + Strang split.
[NEAR_FIELD_SOURCE]
mode = DYNAMIC_PLASTIC
solver_kind = RADIAL_LAGRANGIAN
elastic_radius_factor = 3.0
near_field_dt = 1.0e-5
output_cadence_microseconds = 100
profile_output_cadence_microseconds = 100
radial_cells = 200
# 549 m free-field gauge enablement: extend the radial outer domain
# past the gauge range so the propagating elastic wave reaches the
# extraction point inside the run horizon (Healy 1971 Project Dribble
# gauge layout: 166, 322, 549 m).
radial_outer_radius_m = 700.0

# HIGHEST-tier EOS: pure-tabulated cavity EOS, no Tillotson patch.
cavity_eos = TABULATED_FULL
tillotson_parameter_set = SALT
cavity_initialization = PHYSICS_BASED

# HIGHEST-tier radiation transport: multigroup, 16 log-spaced groups
# from 1e14 to 1e18 Hz with 17 Simpson sub-points per group (path A
# analytic Mihalas-Mihalas + Kramers + Thomson opacity model).
radiation_phase = MARSHAK_MULTIGROUP
opacity_model = TABULATED_FULL
radiation_n_groups = 16
radiation_freq_min_hz = 1.0e14
radiation_freq_max_hz = 1.0e18
radiation_simpson_points = 17
operator_splitting = STRANG_MULTIGROUP

# HIGHEST-tier time integrator: Shu-Osher 1988 SSP3.
time_integrator = RK3_SSP

# Per-group radiation output for the pass-10 ParaView screenshot.
output_per_group_radiation = true

radiation_max_newton_iter = 10
radiation_newton_tolerance = 1.0e-6
radiation_handoff_debounce_steps = 3
tillotson_extrapolation_warning_threshold_pa = 5e10

[BOUNDARY_CONDITIONS]
bottom = free
sides = free
top = free

[ABSORBING_BC]
enabled = true
x_min = true
x_max = true
y_min = true
y_max = true
z_min = true
z_max = false
