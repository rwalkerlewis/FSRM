<?xml version="1.0"?>
<!--
  Pass-13c three-view ParaView 5.10+ state file for the synthetic
  cavity-formation showcase. Loads ../output/wavefield.xdmf and
  configures three RenderViews:

    1. Source-region (top-left): zoomed in to the cavity at
       (4000, 4000, 4500); displacement-magnitude pseudo-colour with
       Viridis colormap; opacity ramp emphasises the inner shock.
    2. Far-field (right): full domain volume render from the +x +y +z
       octant with Viridis displacement-magnitude.
    3. Surface (bottom-left): a slice at z = +Lz showing the
       free-surface displacement; useful for the Rayleigh-wave
       pattern on the surface.

  Reference: Henderson 2007 "ParaView Guide" (state file schema).
-->
<ParaView>
  <ServerManagerState version="5.10.0">
    <Proxy group="sources" type="XDMFReader" id="1" servers="21">
      <Property name="FileName" id="1.FileName" number_of_elements="1">
        <Element index="0" value="../output/wavefield.xdmf"/>
      </Property>
      <Property name="GridStatus" id="1.GridStatus" number_of_elements="1">
        <Element index="0" value="Wavefield"/>
      </Property>
    </Proxy>
    <!-- View 1: source-region -->
    <Proxy group="views" type="RenderView" id="2" servers="21">
      <Property name="ViewSize" id="2.ViewSize" number_of_elements="2">
        <Element index="0" value="800"/>
        <Element index="1" value="450"/>
      </Property>
      <Property name="CameraPosition" id="2.CameraPosition"
                number_of_elements="3">
        <Element index="0" value="5500.0"/>
        <Element index="1" value="5500.0"/>
        <Element index="2" value="5500.0"/>
      </Property>
      <Property name="CameraFocalPoint" id="2.CameraFocalPoint"
                number_of_elements="3">
        <Element index="0" value="4000.0"/>
        <Element index="1" value="4000.0"/>
        <Element index="2" value="4500.0"/>
      </Property>
      <Property name="CameraViewUp" id="2.CameraViewUp"
                number_of_elements="3">
        <Element index="0" value="0.0"/>
        <Element index="1" value="0.0"/>
        <Element index="2" value="1.0"/>
      </Property>
    </Proxy>
    <!-- View 2: far-field -->
    <Proxy group="views" type="RenderView" id="3" servers="21">
      <Property name="ViewSize" id="3.ViewSize" number_of_elements="2">
        <Element index="0" value="800"/>
        <Element index="1" value="900"/>
      </Property>
      <Property name="CameraPosition" id="3.CameraPosition"
                number_of_elements="3">
        <Element index="0" value="14000.0"/>
        <Element index="1" value="14000.0"/>
        <Element index="2" value="10000.0"/>
      </Property>
      <Property name="CameraFocalPoint" id="3.CameraFocalPoint"
                number_of_elements="3">
        <Element index="0" value="4000.0"/>
        <Element index="1" value="4000.0"/>
        <Element index="2" value="3000.0"/>
      </Property>
      <Property name="CameraViewUp" id="3.CameraViewUp"
                number_of_elements="3">
        <Element index="0" value="0.0"/>
        <Element index="1" value="0.0"/>
        <Element index="2" value="1.0"/>
      </Property>
    </Proxy>
    <!-- View 3: surface (looking down at the free surface) -->
    <Proxy group="views" type="RenderView" id="4" servers="21">
      <Property name="ViewSize" id="4.ViewSize" number_of_elements="2">
        <Element index="0" value="800"/>
        <Element index="1" value="450"/>
      </Property>
      <Property name="CameraPosition" id="4.CameraPosition"
                number_of_elements="3">
        <Element index="0" value="4000.0"/>
        <Element index="1" value="4000.0"/>
        <Element index="2" value="14000.0"/>
      </Property>
      <Property name="CameraFocalPoint" id="4.CameraFocalPoint"
                number_of_elements="3">
        <Element index="0" value="4000.0"/>
        <Element index="1" value="4000.0"/>
        <Element index="2" value="6000.0"/>
      </Property>
      <Property name="CameraViewUp" id="4.CameraViewUp"
                number_of_elements="3">
        <Element index="0" value="0.0"/>
        <Element index="1" value="1.0"/>
        <Element index="2" value="0.0"/>
      </Property>
    </Proxy>
    <!-- Single representation shared across all views -->
    <Proxy group="representations" type="UnstructuredGridRepresentation"
           id="5" servers="21">
      <Property name="Input" id="5.Input" number_of_elements="1">
        <Proxy value="1"/>
      </Property>
      <Property name="ColorArrayName" id="5.ColorArrayName"
                number_of_elements="5">
        <Element index="0" value=""/>
        <Element index="1" value=""/>
        <Element index="2" value=""/>
        <Element index="3" value="POINTS"/>
        <Element index="4" value="wavefield"/>
      </Property>
      <Property name="LookupTable" id="5.LookupTable"
                number_of_elements="1">
        <Proxy value="6"/>
      </Property>
      <Property name="Representation" id="5.Representation"
                number_of_elements="1">
        <Element index="0" value="Surface"/>
      </Property>
      <Property name="Opacity" id="5.Opacity" number_of_elements="1">
        <Element index="0" value="0.85"/>
      </Property>
    </Proxy>
    <Proxy group="lookup_tables" type="PVLookupTable" id="6"
           servers="21">
      <Property name="ColorSpace" id="6.ColorSpace" number_of_elements="1">
        <Element index="0" value="Lab"/>
      </Property>
      <Property name="ApplyPreset" id="6.ApplyPreset"
                number_of_elements="1">
        <Element index="0" value="Viridis (matplotlib)"/>
      </Property>
    </Proxy>
  </ServerManagerState>
</ParaView>
