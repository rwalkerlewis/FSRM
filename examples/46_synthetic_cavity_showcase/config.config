# Pass-13c synthetic cavity-formation showcase. 1 kt explosion in
# homogeneous granite at 1500 m depth: deep enough that the cavity-
# formation phase finishes before significant interaction with the
# free surface; shallow enough that the radiated wavefield reaches
# the surface within the simulation window so the animation shows
# both the source-region cavity formation AND far-field surface waves.
#
# This is a showcase, not a verification anchor. The configuration
# privileges visual presentation over CI tractability: the showcase
# is intended to be run outside CI on a workstation or HPC node.
#
# References:
#   - Stevens & Day (1985), J. Geophys. Res. 90 (CLVD source).
#   - Patton (1991), LANL technical report (cavity asymmetry).

[SIMULATION]
name = synthetic_cavity_showcase
start_time = 0.0
end_time = 4.0
dt_initial = 0.001
dt_min = 0.0005
dt_max = 0.002
max_timesteps = 8000
output_frequency = 200
output_format = HDF5
fluid_model = NONE
solid_model = ELASTIC
enable_geomechanics = true
enable_faults = false
enable_elastodynamics = true
rtol = 1.0e-6
atol = 1.0e-8
max_nonlinear_iterations = 20

[GRID]
# 8 km x 8 km x 6 km domain. CI-friendly resolution; production
# render uses 64x64x48 and a 4 us output cadence (see README).
nx = 32
ny = 32
nz = 24
Lx = 8000.0
Ly = 8000.0
Lz = 6000.0

[ROCK]
# Homogeneous granite (Mooney 1989 average crustal granite).
density = 2700.0
youngs_modulus = 60.0e9
poissons_ratio = 0.25

[EXPLOSION_SOURCE]
type = UNDERGROUND_NUCLEAR
yield_kt = 1.0
depth_of_burial = 1500.0
location_x = 4000.0
location_y = 4000.0
location_z = 4500.0
onset_time = 0.0
rise_time = 0.05
cavity_overpressure = 5.0e10

[BOUNDARY_CONDITIONS]
bottom = free
sides = free
top = free

[ABSORBING_BC]
enabled = true
x_min = true
x_max = true
y_min = true
y_max = true
z_min = true
z_max = false

[SEISMOMETERS]
enabled = true
formats = SAC
output_dir = output/seismograms
default_quantity = DISPLACEMENT
default_sample_rate_hz = 200.0

# Surface receiver triplet at increasing range.
[SEISMOMETER_1]
sta = NEAR
location_xyz = 4500.0,4000.0,6000.0

[SEISMOMETER_2]
sta = MID
location_xyz = 5500.0,4000.0,6000.0

[SEISMOMETER_3]
sta = FAR
location_xyz = 7000.0,4000.0,6000.0

[OUTPUT]
output_directory = output
format = HDF5
# Pass-13c wavefield output: fine cadence for fluid animation. 8000
# timesteps / 25 = 320 frames at the production resolution. Cinematic.
wavefield_format = HDF5_XDMF
wavefield_cadence_steps = 25
wavefield_basename = wavefield
wavefield_fields = displacement
