# Cannikin, Amchitka Island, AK (1971-11-06) -- RADIAL_LAGRANGIAN variant
# 5 Mt device detonated at 1860 m depth in competent andesite.
#
# This config is the DYNAMIC_PLASTIC + RADIAL_LAGRANGIAN (LOW tier) companion
# to config.config (COUPLED_ANALYTIC). It drives the far-field FEM from the
# 1D radial Lagrangian shock solver instead of the closed-form RDP psi_dot.
# The solver runs at setup time and writes:
#   output/near_field_history.csv  -- 6-component M(t) and Mdot(t)
#   output/near_field_profile.h5   -- per-snapshot radial state
#
# Fidelity tier: LOW (radiation_phase = ZELDOVICH_RAIZER, the default).
# Use config_highest.config variants from Salmon 1964 as a guide if you
# want to engage MARSHAK_GREY / MARSHAK_MULTIGROUP tiers.
#
# Tillotson EOS: GRANITE (closest available to competent andesite;
# the cavity-coefficient table has no andesite entry).
#
# Coordinate system: z=0 at bottom (5000 m depth), z=5000 at surface.
# Explosion at 1860 m depth = z=3140 (within competent andesite).
#
# Layer structure (King, Foster & Bingham 1972; Lay et al. 1984):
#   Tundra / weathered overburden:  0-50 m   (z=4950 to z=5000)
#   Weathered andesite:             50-300 m  (z=4700 to z=4950)
#   Andesite breccia:               300-1200 m (z=3800 to z=4700)
#   Competent andesite:             1200-3000 m (z=2000 to z=3800; emplacement)
#   Deep andesite:                  3000-5000 m (z=0 to z=2000)

[SIMULATION]
name = cannikin_1971_radial
start_time = 0.0
end_time = 0.5
dt_initial = 0.0001
dt_min = 0.00001
dt_max = 0.001
max_timesteps = 5000
output_frequency = 500
output_format = HDF5
fluid_model = NONE
solid_model = ELASTIC
enable_geomechanics = true
enable_faults = false
enable_elastodynamics = true
rtol = 1.0e-6
atol = 1.0e-8
max_nonlinear_iterations = 20

[GRID]
nx = 15
ny = 15
nz = 10
Lx = 10000.0
Ly = 10000.0
Lz = 5000.0

[ROCK]
# Fallback (deep andesite)
density = 2800.0
youngs_modulus = 70.0e9
poissons_ratio = 0.27

[MATERIAL]
heterogeneous = true
gravity = 0.0

[LAYER_1]
# Tundra / weathered overburden: 0-50 m depth
z_top = 5000.0
z_bottom = 4950.0
lambda = 2.03e9
mu = 1.01e9
rho = 1800.0

[LAYER_2]
# Weathered andesite: 50-300 m depth
z_top = 4950.0
z_bottom = 4700.0
lambda = 7.68e9
mu = 5.18e9
rho = 2300.0

[LAYER_3]
# Andesite breccia: 300-1200 m depth
z_top = 4700.0
z_bottom = 3800.0
lambda = 1.58e10
mu = 1.21e10
rho = 2500.0

[LAYER_4]
# Competent andesite: 1200-3000 m depth (emplacement formation)
z_top = 3800.0
z_bottom = 2000.0
lambda = 2.28e10
mu = 1.97e10
rho = 2700.0

[LAYER_5]
# Deep andesite: 3000-5000 m depth
z_top = 2000.0
z_bottom = 0.0
lambda = 3.09e10
mu = 2.69e10
rho = 2800.0

[EXPLOSION_SOURCE]
type = UNDERGROUND_NUCLEAR
yield_kt = 5000.0
depth_of_burial = 1860.0
location_x = 5000.0
location_y = 5000.0
location_z = 3140.0
onset_time = 0.0
rise_time = 0.5
cavity_overpressure = 1.0e10
medium_type = GENERIC

# DYNAMIC_PLASTIC + RADIAL_LAGRANGIAN: 1D radial shock solver with
# Drucker-Prager elastoplasticity, Tillotson EOS (GRANITE parameter set),
# and LOW-tier Zel'dovich-Raizer radiation phase (default).
# The solver runs at setup time and records the full 6-component M(t)
# and Mdot(t) history; the FEM time-stepping injects Mdot(t) as
# equivalent nodal forces (Aki & Richards 2002 ch 4).
[NEAR_FIELD_SOURCE]
mode = DYNAMIC_PLASTIC
solver_kind = RADIAL_LAGRANGIAN
elastic_radius_factor = 3.0
near_field_dt = 1.0e-5
damage_model = DRUCKER_PRAGER
# 100 us cadence: 341,996 rows in CSV -- resolves the source time function
# (the RADIAL_LAGRANGIAN source pulse peaks in ~1 ms and must be sampled
# at sub-ms resolution for correct moment injection into the FEM solver)
output_cadence_microseconds = 100
# 1 s cadence for profile HDF5 -- only ~35 snapshots, avoids multi-GB file
profile_output_cadence_microseconds = 1000000
radial_cells = 200
# Outer radius well beyond the elastic radius (cavity_R ~ 667 m,
# elastic_radius ~ 2001 m) so the outgoing elastic wave is fully
# characterized before the domain boundary.
radial_outer_radius_m = 4000.0
tillotson_parameter_set = GRANITE
cavity_initialization = PHYSICS_BASED
# LOW fidelity tier: Zel'dovich-Raizer end-state approximation
# (pass-7 default; byte-identical to CLOSED_FORM for the radiation phase).
radiation_phase = ZELDOVICH_RAIZER

[BOUNDARY_CONDITIONS]
bottom = free
sides = free
top = free

[ABSORBING_BC]
enabled = true
x_min = true
x_max = true
y_min = true
y_max = true
z_min = true
z_max = false

[SEISMOMETERS]
enabled = true
formats = SAC
output_dir = output/cannikin_1971
default_quantity = DISPLACEMENT
default_sample_rate_hz = 100.0

[SEISMOMETER_1]
# Surface directly above explosion (spall check)
sta = SPALL
location_xyz = 5000.0,5000.0,5000.0

[SEISMOMETER_2]
# 2.5 km east at the surface
sta = STA02
location_xyz = 7500.0,5000.0,5000.0

[SEISMOMETER_3]
# 4 km east at the surface
sta = STA04
location_xyz = 9000.0,5000.0,5000.0

[OUTPUT]
output_directory = output
format = HDF5
wavefield_format = HDF5_XDMF
wavefield_cadence_steps = 100
wavefield_basename = wavefield
wavefield_fields = displacement
