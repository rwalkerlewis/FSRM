# Joint Verification Experiment, Semipalatinsk leg ("Shagan", 1988-09-14)
# Site: Shagan River testing area, Semipalatinsk Test Site, Kazakh SSR
#       (~50.05 N, 78.99 E)
#
# JVE was a paired bilateral US-Soviet experiment with on-site
# monitoring at both shots. The US leg "Kearsarge" was detonated at
# NTS Pahute Mesa on 1988-08-17 (~150 kt). The Soviet leg, simulated
# here, was "Shagan" at Semipalatinsk on 1988-09-14 (~115 kt mb 6.1).
#
# Best-documented non-NTS event of the late Cold War. Bilateral access
# enabled accurate yield estimation by both parties using independent
# techniques: CORRTEX yield-determination instruments downhole on the
# host side, plus open seismic recording on the visiting side.
#
# References:
#   Vergino & Mensing (1990), BSSA 80, "Yield estimation using regional
#       Lg-coda magnitudes" -- JVE results.
#   Sykes & Ekstrom (1989), GJI 99, "Yields and source mechanisms of
#       Soviet underground tests from 1978-1985" -- Shagan source
#       parameters by analogy.
#   Bocharov et al. (1989), "Estimating yields of Soviet underground
#       tests at Semipalatinsk" -- CORRTEX yields, layered velocity
#       model used here.
#
# Coordinate system: z=0 at bottom of 4 km domain, z=4000 at surface.
# Shagan was at ~650 m depth -> z=3350.

[SIMULATION]
name = jve_1988
start_time = 0.0
end_time = 6.0
dt_initial = 0.001
dt_min = 0.0001
dt_max = 0.01
max_timesteps = 6000
output_frequency = 500
output_format = HDF5
fluid_model = NONE
solid_model = ELASTIC
enable_geomechanics = true
enable_faults = false
enable_elastodynamics = true
rtol = 1.0e-6
atol = 1.0e-8
max_nonlinear_iterations = 20

[GRID]
nx = 15
ny = 15
nz = 10
Lx = 8000.0
Ly = 8000.0
Lz = 4000.0

[ROCK]
density = 2700.0
youngs_modulus = 70.0e9
poissons_ratio = 0.25

[MATERIAL]
heterogeneous = true
gravity = 0.0

[LAYER_1]
# Weathered surface / shale: vp=2400 vs=1300 rho=2200
z_top = 4000.0
z_bottom = 3700.0
lambda = 4.21e9
mu = 3.72e9
rho = 2200.0

[LAYER_2]
# Devonian sediment / hornfels: vp=4800 vs=2700 rho=2600
z_top = 3700.0
z_bottom = 2500.0
lambda = 2.20e10
mu = 1.90e10
rho = 2600.0

[LAYER_3]
# Pre-Cambrian granitic basement: vp=6100 vs=3500 rho=2750
z_top = 2500.0
z_bottom = 0.0
lambda = 3.49e10
mu = 3.37e10
rho = 2750.0

[EXPLOSION_SOURCE]
type = UNDERGROUND_NUCLEAR
yield_kt = 115.0
depth_of_burial = 650.0
location_x = 4000.0
location_y = 4000.0
location_z = 3350.0
medium_type = GRANITE
mode = COUPLED_ANALYTIC
explosion_solve_mode = COUPLED_ANALYTIC
onset_time = 0.0
rise_time = 0.05
cavity_overpressure = 1.0e10

[BOUNDARY_CONDITIONS]
bottom = free
sides = free
top = free

[ABSORBING_BC]
enabled = true
x_min = true
x_max = true
y_min = true
y_max = true
z_min = true
z_max = false

[SEISMOMETERS]
enabled = true
formats = SAC
output_dir = output
default_quantity = DISPLACEMENT
default_sample_rate_hz = 100.0

[SEISMOMETER_1]
sta = JVE_EPI
location_xyz = 4000.0,4000.0,4000.0

[SEISMOMETER_2]
sta = JVE_NEAR_E
location_xyz = 5500.0,4000.0,4000.0

[SEISMOMETER_3]
sta = JVE_NEAR_N
location_xyz = 4000.0,5500.0,4000.0

[SEISMOMETER_4]
sta = JVE_FAR_E
location_xyz = 6500.0,4000.0,4000.0

[SEISMOMETER_5]
sta = JVE_FAR_N
location_xyz = 4000.0,6500.0,4000.0
