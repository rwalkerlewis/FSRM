# Pokhran II Shakti-I (1998-05-11): Indian thermonuclear test
# Site: Pokhran Test Range, Rajasthan, India (~27.07 N, 71.72 E)
#
# Pokhran II was a multi-shot series (Shakti-I through Shakti-V) on
# 1998-05-11 and 1998-05-13. This example simulates Shakti-I, the
# instrumented thermonuclear shot. Indian announced yield 43 kt;
# Western seismic estimates 12-25 kt (mb 5.2). The yield discrepancy
# itself is a well-documented case study in mb-to-yield conversion
# under non-NTS host rock.
#
# Shakti-I host rock is granitic gneiss in the Marwar craton, with
# thin alluvium overburden. Emplacement depth ~210 m. Gauging the
# event for V&V is muddied by the simultaneous Shakti-II detonation
# ~1 km away, which superposes on the seismograms. The example
# documents this multi-shot context but configures Shakti-I as a
# single source.
#
# References:
#   Wallace (1998), Seism. Res. Lett. 69, "The May 1998 India and
#       Pakistan nuclear tests" - mb 5.2, source parameters,
#       Western yield estimate.
#   Sikka et al. (2000), BARC News Bulletin, "Update on Pokhran-II"
#       - Indian announced yields, post-test analyses.
#   Sykes & Wallace (1998), GRL 25 - independent yield estimate.
#   Rodgers et al. (2002), BSSA 92, "An update on the lithospheric
#       structure of the Indian shield" - regional crustal velocity.
#
# Coordinate system: z=0 at bottom of 3 km domain, z=3000 at surface.
# Explosion at 210 m depth -> z=2790.
#
# Layer structure (Marwar craton crystalline basement composite,
# Rodgers et al. 2002):
#   Alluvium / weathered top:              0-50 m   (z=2950-3000)
#   Granitic gneiss host rock:             50-1500m (z=1500-2950)
#   Pre-Cambrian basement:                 below 1500m

[SIMULATION]
name = pokhran_ii_1998
start_time = 0.0
end_time = 4.0
dt_initial = 0.001
dt_min = 0.0001
dt_max = 0.01
max_timesteps = 4000
output_frequency = 500
output_format = HDF5
fluid_model = NONE
solid_model = ELASTIC
enable_geomechanics = true
enable_faults = false
enable_elastodynamics = true
rtol = 1.0e-6
atol = 1.0e-8
max_nonlinear_iterations = 20

[GRID]
nx = 16
ny = 16
nz = 12
Lx = 4000.0
Ly = 4000.0
Lz = 3000.0

[ROCK]
density = 2700.0
youngs_modulus = 70.0e9
poissons_ratio = 0.25

[MATERIAL]
heterogeneous = true
gravity = 0.0

[LAYER_1]
# Alluvium / weathered: vp=1900 vs=900 rho=2000
z_top = 3000.0
z_bottom = 2950.0
lambda = 3.96e9
mu = 1.62e9
rho = 2000.0

[LAYER_2]
# Granitic gneiss host rock: vp=5600 vs=3200 rho=2700
z_top = 2950.0
z_bottom = 1500.0
lambda = 3.06e10
mu = 2.76e10
rho = 2700.0

[LAYER_3]
# Pre-Cambrian basement: vp=6300 vs=3650 rho=2800
z_top = 1500.0
z_bottom = 0.0
lambda = 3.65e10
mu = 3.73e10
rho = 2800.0

[EXPLOSION_SOURCE]
type = UNDERGROUND_NUCLEAR
yield_kt = 20.0
depth_of_burial = 210.0
location_x = 2000.0
location_y = 2000.0
location_z = 2790.0
medium_type = GRANITE
mode = COUPLED_ANALYTIC
explosion_solve_mode = COUPLED_ANALYTIC
onset_time = 0.0
rise_time = 0.05
cavity_overpressure = 1.0e+10

[BOUNDARY_CONDITIONS]
bottom = free
sides = free
top = free

[ABSORBING_BC]
enabled = true
x_min = true
x_max = true
y_min = true
y_max = true
z_min = true
z_max = false

[SEISMOMETERS]
enabled = true
formats = SAC
output_dir = output
default_quantity = DISPLACEMENT
default_sample_rate_hz = 100.0

[SEISMOMETER_1]
sta = POK_EPI
location_xyz = 2000.0,2000.0,3000.0

[SEISMOMETER_2]
sta = POK_NEAR_E
location_xyz = 3000.0,2000.0,3000.0

[SEISMOMETER_3]
sta = POK_NEAR_N
location_xyz = 2000.0,3000.0,3000.0

[SEISMOMETER_4]
sta = POK_FAR_E
location_xyz = 3500.0,2000.0,3000.0
