# Mururoa "Xouthos" (1996-01-27): Final French underground test
# Site: Mururoa Atoll, French Polynesia (~21.84 S, 138.96 W)
#
# Last French underground nuclear test before France ratified the
# CTBT. The 1995-96 final test campaign (Octant, Mercure, Phenix,
# Maja, Xouthos) was internationally controversial and consequently
# was one of the best-monitored Pacific atoll test series.
#
# This example simulates Xouthos, the final shot. Yield ~120 kt;
# emplaced under the basaltic basement of Mururoa atoll at ~1100 m
# depth via a vertical shaft from a barge platform in the lagoon.
#
# Atoll geology: thin coral cap over a subsiding volcanic edifice
# (Cretaceous basalt with thick volcanic tuff overburden).
#
# This config is a 3-D solid-Earth approximation that omits the ocean
# halfspace (no fluid coupling). Coupling the seismic / acoustic ocean
# response is named axis-5 future work; the current model captures
# only the body-wave field through the solid Earth.
#
# References:
#   IFRC / IAEA (1998), "The radiological situation at Mururoa and
#       Fangataufa atolls" -- official post-test geology summary.
#   Massin et al. (2003), Pure Appl. Geophys., "Crustal structure of
#       Mururoa Atoll from active seismic data" -- velocity model.
#   Adushkin & Spivak (2015), "Underground Explosions" --
#       Pacific-atoll test analyses.

[SIMULATION]
name = mururoa_1996
start_time = 0.0
end_time = 6.0
dt_initial = 0.001
dt_min = 0.0001
dt_max = 0.01
max_timesteps = 6000
output_frequency = 500
output_format = HDF5
fluid_model = NONE
solid_model = ELASTIC
enable_geomechanics = true
enable_faults = false
enable_elastodynamics = true
rtol = 1.0e-6
atol = 1.0e-8
max_nonlinear_iterations = 20

[GRID]
nx = 15
ny = 15
nz = 10
Lx = 8000.0
Ly = 8000.0
Lz = 4000.0

[ROCK]
density = 2800.0
youngs_modulus = 75.0e9
poissons_ratio = 0.25

[MATERIAL]
heterogeneous = true
gravity = 0.0

[LAYER_1]
# Coral reef cap: vp=2000 vs=1100 rho=2100
z_top = 4000.0
z_bottom = 3700.0
lambda = 4.21e9
mu = 3.72e9
rho = 2200.0

[LAYER_2]
# Volcanic tuff / breccia: vp=3500 vs=1900 rho=2400
z_top = 3700.0
z_bottom = 3100.0
lambda = 1.21e10
mu = 8.66e9
rho = 2400.0

[LAYER_3]
# Cretaceous basaltic basement: vp=5800 vs=3300 rho=2800
z_top = 3100.0
z_bottom = 0.0
lambda = 3.31e10
mu = 3.05e10
rho = 2800.0

[EXPLOSION_SOURCE]
type = UNDERGROUND_NUCLEAR
yield_kt = 120.0
depth_of_burial = 650.0
location_x = 4000.0
location_y = 4000.0
location_z = 3350.0
medium_type = GRANITE
mode = COUPLED_ANALYTIC
explosion_solve_mode = COUPLED_ANALYTIC
onset_time = 0.0
rise_time = 0.05
cavity_overpressure = 1.0e10

[BOUNDARY_CONDITIONS]
bottom = free
sides = free
top = free

[ABSORBING_BC]
enabled = true
x_min = true
x_max = true
y_min = true
y_max = true
z_min = true
z_max = false

[SEISMOMETERS]
enabled = true
formats = SAC
output_dir = output
default_quantity = DISPLACEMENT
default_sample_rate_hz = 100.0

[SEISMOMETER_1]
sta = MUR_EPI
location_xyz = 4000.0,4000.0,4000.0

[SEISMOMETER_2]
sta = MUR_NEAR_E
location_xyz = 5500.0,4000.0,4000.0

[SEISMOMETER_3]
sta = MUR_NEAR_N
location_xyz = 4000.0,5500.0,4000.0

[SEISMOMETER_4]
sta = MUR_FAR_E
location_xyz = 6500.0,4000.0,4000.0

[SEISMOMETER_5]
sta = MUR_FAR_N
location_xyz = 4000.0,6500.0,4000.0
