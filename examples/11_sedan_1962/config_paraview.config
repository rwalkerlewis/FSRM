# Sedan 1962 -- finer mesh + dense time output for ParaView visualisation.
# Same physics as config_analytic_fast.config (COUPLED_ANALYTIC + distributed
# UNIFORM_SPHERE source, layered alluvium/tuff/Paleozoic, absorbing sides).
# Estimated runtime ~ 2 to 3 hours on 1 rank.

[SIMULATION]
name = sedan_1962_paraview
start_time = 0.0
end_time = 1.5
dt_initial = 0.001
dt_min = 0.0001
dt_max = 0.01
max_timesteps = 2000
output_frequency = 10
output_format = HDF5
fluid_model = NONE
solid_model = ELASTIC
enable_geomechanics = true
enable_faults = false
enable_elastodynamics = true
rtol = 1.0e-6
atol = 1.0e-8
max_nonlinear_iterations = 20

[GRID]
nx = 15
ny = 15
nz = 10
Lx = 30000.0
Ly = 30000.0
Lz = 5000.0

[ROCK]
density = 2700.0
youngs_modulus = 65.0e9
poissons_ratio = 0.25

[MATERIAL]
heterogeneous = true
gravity = 0.0

[LAYER_1]
z_top = 5000.0
z_bottom = 4700.0
lambda = 3.33e9
mu = 1.09e9
rho = 1700.0

[LAYER_2]
z_top = 4700.0
z_bottom = 4200.0
lambda = 1.42e10
mu = 1.33e10
rho = 2300.0

[LAYER_3]
z_top = 4200.0
z_bottom = 0.0
lambda = 3.37e10
mu = 2.59e10
rho = 2700.0

[EXPLOSION_SOURCE]
type = UNDERGROUND_NUCLEAR
yield_kt = 104.0
depth_of_burial = 194.0
location_x = 15000.0
location_y = 15000.0
location_z = 4806.0
onset_time = 0.0
rise_time = 0.02
cavity_overpressure = 1.0e10
medium_type = ALLUVIUM

[SOURCE_DISTRIBUTION]
mode = UNIFORM_SPHERE
support_radius_factor = 50.0
min_cells = 1

[BOUNDARY_CONDITIONS]
bottom = free
sides = free
top = free

[ABSORBING_BC]
enabled = true
x_min = true
x_max = true
y_min = true
y_max = true
z_min = true
z_max = false

[SEISMOMETERS]
enabled = true
formats = SAC
output_dir = output/sedan_1962_paraview
default_quantity = VELOCITY
default_sample_rate_hz = 200.0

[SEISMOMETER_1]
sta = SPALL
location_xyz = 15000.0,15000.0,5000.0

[SEISMOMETER_2]
sta = STA05
location_xyz = 20000.0,15000.0,5000.0

[SEISMOMETER_3]
sta = STA10
location_xyz = 25000.0,15000.0,5000.0

[SEISMOMETER_4]
sta = STA02
location_xyz = 17000.0,15000.0,5000.0

[SEISMOMETER_5]
sta = N05
location_xyz = 15000.0,20000.0,5000.0
