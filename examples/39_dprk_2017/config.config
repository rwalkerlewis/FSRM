# DPRK Sixth Underground Nuclear Test (2017-09-03)
# Punggye-ri Test Site, Mt. Mantap, Kilju County, North Hamgyong, DPRK
#
# Body-wave magnitude mb 6.3 (USGS); analyses bracket yield at 100-370 kt,
# announced as a "thermonuclear" device. Public-data anchor: this is the
# most-instrumented modern underground nuclear test, with hundreds of
# IRIS stations recording the event and broad academic literature.
#
# References:
#   Voytan et al. (2019), GRL 46, "Yield estimates for the six North
#       Korean underground nuclear tests" - DPRK 2017 mb 6.30, ~250 kt
#       central estimate.
#   Wen et al. (2018), GRL 45, "Topographic and source backscattering
#       effects from the 2017 NK test" - Mt. Mantap topography
#       contaminates teleseismic surface-wave recordings.
#   Pabian and Coblentz (2018), CNS Occasional Paper 38, "The 6th NK
#       Nuclear Test" - geological context, host-rock granite under
#       tuff overburden.
#   Tian et al. (2018), GJI 213, "Source parameters of the 2017 NK
#       test from regional and teleseismic moment tensor analysis"
#       - ~250 kt, depth ~600-800 m below Mt. Mantap summit.
#
# Coordinate system: z=0 at bottom of 6 km domain, z=6000 at surface.
# Explosion at 600 m below summit (Mt. Mantap summit ~2200 m above
# regional base) corresponds to z=5400 in this domain.
#
# Layer structure (Pabian & Coblentz 2018; Wen et al 2018; regional
# Korean Peninsula crustal velocity model):
#   Volcanic tuff / weathered overburden:  0-300m below summit
#   Competent granite (host rock):         300-3000m below summit
#   Pre-Cambrian metamorphic basement:     deeper

[SIMULATION]
name = dprk_2017
start_time = 0.0
end_time = 5.0
dt_initial = 0.001
dt_min = 0.0001
dt_max = 0.01
max_timesteps = 5000
output_frequency = 500
output_format = HDF5
fluid_model = NONE
solid_model = ELASTIC
enable_geomechanics = true
enable_faults = false
enable_elastodynamics = true
rtol = 1.0e-6
atol = 1.0e-8
max_nonlinear_iterations = 20

[GRID]
nx = 15
ny = 15
nz = 10
Lx = 8000.0
Ly = 8000.0
Lz = 6000.0

[ROCK]
# Fallback (deep granite basement)
density = 2700.0
youngs_modulus = 75.0e9
poissons_ratio = 0.25

[MATERIAL]
heterogeneous = true
gravity = 0.0

[LAYER_1]
# Volcanic tuff / weathered overburden: 0-300m below summit
# vp=2400, vs=1300, rho=2200 -> lambda=4.21e9, mu=3.72e9
z_top = 6000.0
z_bottom = 5700.0
lambda = 4.21e9
mu = 3.72e9
rho = 2200.0

[LAYER_2]
# Competent granite host rock: 300-3000m below summit
# vp=5800, vs=3300, rho=2700 -> lambda=3.20e10, mu=2.94e10
z_top = 5700.0
z_bottom = 3000.0
lambda = 3.20e10
mu = 2.94e10
rho = 2700.0

[LAYER_3]
# Pre-Cambrian metamorphic basement: below 3000m
# vp=6300, vs=3650, rho=2800 -> lambda=3.65e10, mu=3.73e10
z_top = 3000.0
z_bottom = 0.0
lambda = 3.65e10
mu = 3.73e10
rho = 2800.0

[EXPLOSION_SOURCE]
type = UNDERGROUND_NUCLEAR
yield_kt = 250.0
depth_of_burial = 600.0
location_x = 4000.0
location_y = 4000.0
location_z = 5400.0
medium_type = GRANITE
mode = COUPLED_ANALYTIC
explosion_solve_mode = COUPLED_ANALYTIC
onset_time = 0.0
rise_time = 0.05
cavity_overpressure = 1.0e10

[BOUNDARY_CONDITIONS]
bottom = free
sides = free
top = free

[ABSORBING_BC]
enabled = true
x_min = true
x_max = true
y_min = true
y_max = true
z_min = true
z_max = false

[SEISMOMETERS]
enabled = true
formats = SAC
output_dir = output
default_quantity = DISPLACEMENT
default_sample_rate_hz = 100.0

[SEISMOMETER_1]
# Surface directly above explosion (epicentral)
sta = DPRK_EPI
location_xyz = 4000.0,4000.0,6000.0

[SEISMOMETER_2]
# 1500 m east at the surface
sta = DPRK_NEAR_E
location_xyz = 5500.0,4000.0,6000.0

[SEISMOMETER_3]
# 1500 m north at the surface
sta = DPRK_NEAR_N
location_xyz = 4000.0,5500.0,6000.0

[SEISMOMETER_4]
# 2500 m east at the surface
sta = DPRK_FAR_E
location_xyz = 6500.0,4000.0,6000.0

[SEISMOMETER_5]
# 2500 m north at the surface
sta = DPRK_FAR_N
location_xyz = 4000.0,6500.0,6000.0
