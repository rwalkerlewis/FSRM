# DPRK Sixth Underground Nuclear Test (2017-09-03) -- RADIAL_LAGRANGIAN variant
# Punggye-ri Test Site, Mt. Mantap, Kilju County, DPRK
#
# This config runs the full coupled simulation:
#   - 1D radial Lagrangian shock solver (DYNAMIC_PLASTIC + RADIAL_LAGRANGIAN)
#     records M(t) and cavity-radius history at setup time.
#   - 3D FEM far-field on a graded tetrahedral Gmsh mesh (30x30x20 km).
#   - Mesh is spatially graded: ~300 m near the source, ~1500 m at the
#     domain boundary, enabling resolution of the near-source wavefield
#     while capturing far-field body-wave propagation to 15 km offset.
#   - Lagrangian source ball for ParaView visualization of the near-source
#     zone (cavity / elastic radius boundary).
#
# Radial Lagrangian solver outputs (written at setup, before time stepping):
#   output_radial/near_field_history.csv  -- 6-component M(t), Mdot(t)
#   output_radial/near_field_profile.h5   -- per-snapshot radial state
#   output_radial/near_field_profile.xdmf -- ParaView wrapper
#
# Wavefield snapshots (every 25 steps ~ 0.025 s):
#   output_radial/wavefield.h5
#   output_radial/wavefield_paraview.xdmf -- full XDMF2 for ParaView
#
# Fidelity tier: LOW (radiation_phase = ZELDOVICH_RAIZER, pass-7 default).
#
# References:
#   Voytan et al. (2019), GRL 46, ~250 kt central estimate (mb 6.30).
#   Pabian and Coblentz (2018), CNS, host-rock granite under tuff.
#   Mueller and Murphy (1971), BSSA 61, scaled source parameters.
#
# Coordinate system: z=0 at bottom, z=20000 at surface.
# Source at x=15000, y=15000, z=19400 (600 m below surface).

[SIMULATION]
name = dprk_2017_radial
start_time = 0.0
end_time = 3.0
dt_initial = 0.001
dt_min = 0.0001
dt_max = 0.005
max_timesteps = 3000
output_frequency = 100
output_format = HDF5
fluid_model = NONE
solid_model = ELASTIC
enable_geomechanics = true
enable_faults = false
enable_elastodynamics = true
rtol = 1.0e-6
atol = 1.0e-8
max_nonlinear_iterations = 20

[GRID]
mesh_type = GMSH
mesh_file = meshes/dprk_2017_graded.msh

[ROCK]
# Fallback (deep metamorphic basement)
density = 2800.0
youngs_modulus = 80.0e9
poissons_ratio = 0.25

[MATERIAL]
heterogeneous = true
gravity = 0.0
assignment = gmsh_label

[MATERIAL_REGION_1]
# Volcanic tuff / weathered overburden: 0-300m below summit
# vp=2400, vs=1300, rho=2200 -> lambda=4.21e9, mu=3.72e9
gmsh_label = tuff
youngs_modulus = 8.90e9
poissons_ratio = 0.25
density = 2200.0

[MATERIAL_REGION_2]
# Competent granite host rock (explosion zone): 300-3000m below summit
# vp=5800, vs=3300, rho=2700 -> lambda=3.20e10, mu=2.94e10
gmsh_label = granite
youngs_modulus = 69.90e9
poissons_ratio = 0.19
density = 2700.0

[MATERIAL_REGION_3]
# Pre-Cambrian metamorphic basement: below 3000m
# vp=6300, vs=3650, rho=2800 -> lambda=3.65e10, mu=3.73e10
gmsh_label = basement
youngs_modulus = 83.90e9
poissons_ratio = 0.22
density = 2800.0

[EXPLOSION_SOURCE]
type = UNDERGROUND_NUCLEAR
yield_kt = 250.0
depth_of_burial = 600.0
location_x = 15000.0
location_y = 15000.0
location_z = 19400.0
medium_type = GRANITE
mode = DYNAMIC_PLASTIC
explosion_solve_mode = DYNAMIC_PLASTIC
onset_time = 0.0
rise_time = 0.05
cavity_overpressure = 1.0e10

# ---- 1D Radial Lagrangian near-field solver ----
# Drucker-Prager elastoplasticity + Tillotson EOS (GRANITE).
# LOW fidelity tier: Zel'dovich-Raizer end-state radiation phase.
# The solver runs at setup time and records the full 6-component
# moment-rate tensor history; the FEM time-stepping injects Mdot(t)
# as equivalent nodal forces (Aki & Richards 2002 ch 4).
[NEAR_FIELD_SOURCE]
mode = DYNAMIC_PLASTIC
solver_kind = RADIAL_LAGRANGIAN
# Elastic radius = 3 * cavity radius (Mueller & Murphy 1971)
elastic_radius_factor = 3.0
# 10 us time step -- resolves the ~1 ms source pulse
near_field_dt = 1.0e-5
damage_model = DRUCKER_PRAGER
# 100 us output cadence for CSV (resolves sub-ms pulse)
output_cadence_microseconds = 100
# 500 ms cadence for radial profile HDF5 (avoids large files)
profile_output_cadence_microseconds = 500000
radial_cells = 300
# Outer boundary at 6 km -- well beyond elastic radius (~840 m)
radial_outer_radius_m = 6000.0
tillotson_parameter_set = GRANITE
cavity_initialization = PHYSICS_BASED
radiation_phase = ZELDOVICH_RAIZER
# 3D source ball for near-source visualization in ParaView
cavity_geometry = THREE_DIMENSIONAL
cavity_radius_m = 280.0
outer_radius_m = 900.0
mesh_path = ../../cache/source_ball_meshes/dprk_2017
overburden_K0 = 0.5
source_ball_radiation_discretization = 4
source_forcing_enabled = true
source_time_function = MUELLER_MURPHY
source_yield_kt = 250.0
source_deposition_duration_s = 0.001
source_deposition_efficiency = 1.0

[BOUNDARY_CONDITIONS]
bottom = free
sides = free
top = free

[ABSORBING_BC]
enabled = true
x_min = true
x_max = true
y_min = true
y_max = true
z_min = true
z_max = false

[SEISMOMETERS]
enabled = true
formats = SAC
output_dir = output_radial
default_quantity = DISPLACEMENT
default_sample_rate_hz = 100.0

[SEISMOMETER_1]
# Epicentral: surface directly above explosion
sta = DPRK_EPI
location_xyz = 15000.0,15000.0,20000.0

[SEISMOMETER_2]
# Near-field east (1.5 km offset)
sta = DPRK_NEAR_E
location_xyz = 16500.0,15000.0,20000.0

[SEISMOMETER_3]
# Near-field north (1.5 km offset)
sta = DPRK_NEAR_N
location_xyz = 15000.0,16500.0,20000.0

[SEISMOMETER_4]
# Far-field east (5 km offset)
sta = DPRK_FAR_E
location_xyz = 20000.0,15000.0,20000.0

[SEISMOMETER_5]
# Far-field north (5 km offset)
sta = DPRK_FAR_N
location_xyz = 15000.0,20000.0,20000.0

[SEISMOMETER_6]
# Very far east (10 km offset) -- far-field body wave
sta = DPRK_VFAR_E
location_xyz = 25000.0,15000.0,20000.0

[SEISMOMETER_7]
# Very far north (10 km offset) -- far-field body wave
sta = DPRK_VFAR_N
location_xyz = 15000.0,25000.0,20000.0

[SEISMOMETER_8]
# Borehole sensor near source zone (3 km depth)
sta = DPRK_BOREHOLE
location_xyz = 15000.0,15000.0,17000.0

[OUTPUT]
output_directory = output_radial
format = HDF5
wavefield_format = HDF5_XDMF
wavefield_cadence_steps = 25
wavefield_basename = wavefield
wavefield_fields = displacement
source_ball_3d_output_format = HDF5_XDMF
source_ball_3d_output_cadence_steps = 10
