# Lop Nor 1996-07-29: Final Chinese underground nuclear test
# Site: Lop Nor Test Site, Xinjiang, PRC (~41.66 N, 88.41 E)
#
# Body-wave magnitude mb 5.0 (USGS); estimated yield ~5 kt. Last
# Chinese test before signing the CTBT in September 1996. Basin-
# context emplacement gives less topography contamination than the
# Tian Shan tunnel sites used for the 1976 series, and the open
# desert basin keeps surface-wave excitation cleaner.
#
# References:
#   Wen et al. (1999), GRL 26, "Seismic source parameters for the
#       1996 Lop Nor explosion" - mb 5.0, depth ~700-900 m.
#   Sykes (2002), "Yields of the Soviet & Chinese explosions" -
#       central yield estimate 5 kt (range 1-10 kt).
#   IRIS event service, IDC bulletin 1996.211.
#
# Coordinate system: z=0 at bottom of 4 km domain, z=4000 at surface.
# Explosion at 800 m depth -> z=3200.
#
# Layer structure (Tian Shan basin sediment + crystalline basement
# composite based on Bao et al. 2011 regional crustal model):
#   Tertiary sediment cover:               0-200 m   (z=3800-4000)
#   Mesozoic basement / weathered granite: 200-1500m (z=2500-3800)
#   Pre-Cambrian basement:                 below 1500m

[SIMULATION]
name = lop_nor_1996
start_time = 0.0
end_time = 5.0
dt_initial = 0.001
dt_min = 0.0001
dt_max = 0.01
max_timesteps = 5000
output_frequency = 500
output_format = HDF5
fluid_model = NONE
solid_model = ELASTIC
enable_geomechanics = true
enable_faults = false
enable_elastodynamics = true
rtol = 1.0e-6
atol = 1.0e-8
max_nonlinear_iterations = 20

[GRID]
nx = 20
ny = 20
nz = 12
Lx = 6000.0
Ly = 6000.0
Lz = 4000.0

[ROCK]
density = 2700.0
youngs_modulus = 65.0e9
poissons_ratio = 0.25

[MATERIAL]
heterogeneous = true
gravity = 0.0

[LAYER_1]
# Tertiary sediment cover: vp=2200 vs=1200 rho=2100
z_top = 4000.0
z_bottom = 3800.0
lambda = 4.10e9
mu = 3.02e9
rho = 2100.0

[LAYER_2]
# Mesozoic / weathered granite: vp=5400 vs=3100 rho=2650
z_top = 3800.0
z_bottom = 2500.0
lambda = 2.83e10
mu = 2.55e10
rho = 2650.0

[LAYER_3]
# Pre-Cambrian basement: vp=6200 vs=3550 rho=2750
z_top = 2500.0
z_bottom = 0.0
lambda = 3.65e10
mu = 3.47e10
rho = 2750.0

[EXPLOSION_SOURCE]
type = UNDERGROUND_NUCLEAR
yield_kt = 5.0
depth_of_burial = 800.0
location_x = 3000.0
location_y = 3000.0
location_z = 3200.0
medium_type = GRANITE
mode = COUPLED_ANALYTIC
explosion_solve_mode = COUPLED_ANALYTIC
onset_time = 0.0
rise_time = 0.05
cavity_overpressure = 1.0e+10

[BOUNDARY_CONDITIONS]
bottom = free
sides = free
top = free

[ABSORBING_BC]
enabled = true
x_min = true
x_max = true
y_min = true
y_max = true
z_min = true
z_max = false

[SEISMOMETERS]
enabled = true
formats = SAC
output_dir = output
default_quantity = DISPLACEMENT
default_sample_rate_hz = 100.0

[SEISMOMETER_1]
sta = LOP_EPI
location_xyz = 3000.0,3000.0,4000.0

[SEISMOMETER_2]
sta = LOP_NEAR_E
location_xyz = 4500.0,3000.0,4000.0

[SEISMOMETER_3]
sta = LOP_NEAR_N
location_xyz = 3000.0,4500.0,4000.0

[SEISMOMETER_4]
sta = LOP_FAR_E
location_xyz = 5500.0,3000.0,4000.0
