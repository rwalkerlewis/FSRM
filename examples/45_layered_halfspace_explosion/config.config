# Layered halfspace explosion (Haskell-Thomson reference). Pass-13c
# academic verification anchor with closed-form reference for the
# Rayleigh-wave (Rg) phase arrival time at a known surface range.
#
# Geology: 4-layer Earth (sediment, upper crust, lower crust, mantle).
# Free surface on top. Explosion source in the upper crust. The
# Haskell 1953 / Thomson 1950 propagator-matrix method gives the
# expected dispersion and arrival time for the Rg phase as a function
# of the layer parameters.
#
# References:
#   - Haskell, N. A. (1953), Bull. Seism. Soc. Am. 43, pp 17-34.
#   - Thomson, W. T. (1950), J. Appl. Phys. 21, pp 89-93.
#   - Aki & Richards (2002), "Quantitative Seismology" 2nd ed, ch 7
#     (modern propagator-matrix exposition).

[SIMULATION]
name = layered_halfspace_explosion
start_time = 0.0
end_time = 30.0
dt_initial = 0.01
dt_min = 0.005
dt_max = 0.02
max_timesteps = 4000
output_frequency = 100
output_format = HDF5
fluid_model = NONE
solid_model = ELASTIC
enable_geomechanics = true
enable_faults = false
enable_elastodynamics = true
rtol = 1.0e-6
atol = 1.0e-8
max_nonlinear_iterations = 20

[GRID]
# 100 km horizontal, 60 km vertical. Coarse for CI tractability.
nx = 24
ny = 24
nz = 16
Lx = 100000.0
Ly = 100000.0
Lz = 60000.0

[ROCK]
# Default fallback (used outside the heterogeneous layer set).
density = 3300.0
youngs_modulus = 200.0e9
poissons_ratio = 0.25

[MATERIAL]
heterogeneous = true
gravity = 0.0

# Layer 1: sediment, 0-2 km depth from surface (z = 60-58 km in mesh).
# Vp ~ 3.0 km/s, Vs ~ 1.7 km/s, rho 2300 kg/m^3.
[LAYER_1]
z_top = 60000.0
z_bottom = 58000.0
lambda = 6.50e9
mu = 6.65e9
rho = 2300.0

# Layer 2: upper crust, 2-15 km depth.
# Vp ~ 5.5 km/s, Vs ~ 3.2 km/s, rho 2700 kg/m^3.
[LAYER_2]
z_top = 58000.0
z_bottom = 45000.0
lambda = 2.66e10
mu = 2.76e10
rho = 2700.0

# Layer 3: lower crust, 15-35 km depth.
# Vp ~ 6.6 km/s, Vs ~ 3.7 km/s, rho 2900 kg/m^3.
[LAYER_3]
z_top = 45000.0
z_bottom = 25000.0
lambda = 4.65e10
mu = 3.97e10
rho = 2900.0

# Layer 4: mantle (uppermost), > 35 km depth.
# Vp ~ 8.0 km/s, Vs ~ 4.5 km/s, rho 3300 kg/m^3.
[LAYER_4]
z_top = 25000.0
z_bottom = 0.0
lambda = 8.40e10
mu = 6.68e10
rho = 3300.0

[EXPLOSION_SOURCE]
# 1 kt-equivalent explosion at 5 km depth (in upper crust).
type = UNDERGROUND_NUCLEAR
yield_kt = 1.0
depth_of_burial = 5000.0
location_x = 50000.0
location_y = 50000.0
location_z = 55000.0
onset_time = 0.0
rise_time = 0.05
cavity_overpressure = 1.0e10

[BOUNDARY_CONDITIONS]
bottom = free
sides = free
top = free

[ABSORBING_BC]
enabled = true
x_min = true
x_max = true
y_min = true
y_max = true
z_min = true
z_max = false

[SEISMOMETERS]
enabled = true
formats = SAC
output_dir = output/seismograms
default_quantity = DISPLACEMENT
default_sample_rate_hz = 50.0

# Surface receiver at 50 km range. The Haskell-Thomson reference
# predicts the Rg phase arrival time at ~ r / v_Rg with v_Rg ~ 3.0
# km/s (sediment-dominant Rg in this layer set). At 50 km the
# expected Rg arrival is ~ 16.7 s; gate verifies within 5 percent.
[SEISMOMETER_1]
sta = HK1
location_xyz = 75000.0,50000.0,60000.0

[SEISMOMETER_2]
sta = HK2
location_xyz = 90000.0,50000.0,60000.0

[OUTPUT]
output_directory = output
format = HDF5
wavefield_format = HDF5_XDMF
wavefield_cadence_steps = 100
wavefield_basename = wavefield
wavefield_fields = displacement
