# Lamb's problem: vertical step force on the surface of an elastic
# halfspace (Lamb 1904). Pass-13c verification anchor with closed-form
# reference (Eringen & Suhubi 1975 vol II; Mooney 1974 numerical
# tables). The simulation's wavefield output runs at fine cadence so
# ParaView can render the full P-wave + S-wave + Rayleigh-wave fronts.
#
# Coordinate convention:
#   x, y on the free surface (z = +Lz); source at the centre of the
#   top surface. Absorbing boundaries on sides and bottom emulate an
#   infinite halfspace. Free surface on top.
#
# Reference closed-form solution: vertical surface displacement at
# range r from a vertical step force of magnitude F0 acting on the
# free surface scales (long-time, far-field) as the Rayleigh-wave
# pole contribution
#   u_z(r, t) ~ A_R * F0 / (mu * sqrt(r * lambda_R))
# with A_R the Rayleigh-pole residue and lambda_R the Rayleigh
# wavelength. For factor-2 verification we sample three surface
# ranges and check the 1/sqrt(r) scaling.
#
# References:
#   - Lamb, H. (1904), Phil. Trans. Roy. Soc. London A 203, pp 1-42.
#   - Eringen & Suhubi (1975), "Elastodynamics" vol II, ch 7.
#   - Mooney, H. M. (1974), Bull. Seism. Soc. Am. 64, pp 473-491
#     (numerical tables for Lamb's problem).

[SIMULATION]
name = lambs_problem
start_time = 0.0
end_time = 2.0
dt_initial = 0.001
dt_min = 0.0005
dt_max = 0.002
max_timesteps = 4000
output_frequency = 100
output_format = HDF5
fluid_model = NONE
solid_model = ELASTIC
enable_geomechanics = true
enable_faults = false
enable_elastodynamics = true
rtol = 1.0e-6
atol = 1.0e-8
max_nonlinear_iterations = 20

[GRID]
# 5 km cubic domain; coarse mesh for CI tractability. Use the Python
# scripts in scripts/plot_wavefield.py to render the output.
nx = 16
ny = 16
nz = 16
Lx = 5000.0
Ly = 5000.0
Lz = 5000.0

[ROCK]
# Granite halfspace (single homogeneous material).
density = 2700.0
youngs_modulus = 60.0e9
poissons_ratio = 0.25

[EXPLOSION_SOURCE]
# Lamb's problem uses a point force on the free surface; the FSRM
# pipeline approximates this with a near-surface explosion source. The
# moment-tensor kernel is isotropic, but the surface dominates the
# response so the radiated wavefield is qualitatively Lamb-like.
type = UNDERGROUND_NUCLEAR
yield_kt = 0.001
depth_of_burial = 50.0
location_x = 2500.0
location_y = 2500.0
location_z = 4950.0
onset_time = 0.0
rise_time = 0.005
cavity_overpressure = 1.0e9

[BOUNDARY_CONDITIONS]
bottom = free
sides = free
top = free

[ABSORBING_BC]
enabled = true
x_min = true
x_max = true
y_min = true
y_max = true
z_min = true
z_max = false

[SEISMOMETERS]
enabled = true
formats = SAC
output_dir = output/seismograms
default_quantity = DISPLACEMENT
default_sample_rate_hz = 1000.0

# Three surface receivers along the +x axis at increasing range. The
# closed-form Lamb solution predicts the vertical displacement at each
# scales with 1/sqrt(r) for the Rayleigh-wave contribution.
[SEISMOMETER_1]
sta = LAMB1
location_xyz = 3000.0,2500.0,4950.0

[SEISMOMETER_2]
sta = LAMB2
location_xyz = 3500.0,2500.0,4950.0

[SEISMOMETER_3]
sta = LAMB3
location_xyz = 4000.0,2500.0,4950.0

# Pass-13c wavefield output: ParaView-renderable HDF5 + XDMF. Cadence
# at every 50 timesteps so the resulting animation is fluid (~80 frames
# at the default time horizon).
[OUTPUT]
output_directory = output
format = HDF5
wavefield_format = HDF5_XDMF
wavefield_cadence_steps = 50
wavefield_basename = wavefield
wavefield_fields = displacement
